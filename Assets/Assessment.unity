  namaSceneBerikutnya: 
  panelLegenda: {fileID: 723378546}
  textLegenda: {fileID: 1211878254}
  tombolNextSlide: {fileID: 519957521}
  tombolPrevSlide: {fileID: 844321487}
  slideAreaAtas:
  - teksLegenda: "A. Hopper\n\nTempat penampungan tablet yang siap untuk dikemas.
      \n\n\n\n\n "
    uiTitik: {fileID: 18795075}
    mesinHighlight:
    - {fileID: 1953661585}
    - {fileID: 1508120353}
    ghostHighlight: []
  - teksLegenda: "B. Vibrator A&B\n\nTempat menampung tablet dari Hopper sebelum
      masuk pada Sliding maupun Spiral.\n\n "
    uiTitik: {fileID: 17082224}
    mesinHighlight:
    - {fileID: 7469660299761587079}
    ghostHighlight: []
  - teksLegenda: 'C. Feeder A&B


      Menggerakkan Tablet dari Hopper ke Feeder
      A ketika Feeder B kosong dan menggetarkan feeder B agar Tablet turun ke Sliding
      atau Spiral '
    uiTitik: {fileID: 1322759491}
    mesinHighlight:
    - {fileID: 6806007555987017486}
    - {fileID: 4540608606840393020}
    ghostHighlight: []
  - teksLegenda: 'D. Brush


      Membersihkan sisa Granul dan mengatur aliran Tablet
      dari Feeder ke bagian Sliding atau Spiral.  '
    uiTitik: {fileID: 2050634916}
    mesinHighlight:
    - {fileID: 2014668553}
    - {fileID: 8820575238923179623}
    ghostHighlight: []
  - teksLegenda: 'E. Lampu Andon


      Indikator kondisi mesin



'
    uiTitik: {fileID: 382061817}
    mesinHighlight:
    - {fileID: 1369041482}
    ghostHighlight: []
  slideInfoPartC:
  - teksLegenda: 'F. Sliding


      Saluran yang mengarahkan tablet dari feeder
      ke bagian shutter'
    uiTitik: {fileID: 152976895}
    mesinHighlight: []
    ghostHighlight:
    - {fileID: 0}
  - teksLegenda: 'G. Shutter


      Saluran untuk mengarahkan tablet menuju lubang
      sealing roll dan mengatur jumlah tablet yang masuk'
    uiTitik: {fileID: 967206084}
    mesinHighlight: []
    ghostHighlight:
    - {fileID: 0}
  slideInfoPartB:
  - teksLegenda: 'H. Sealing Roll


      Tempat untuk menyetrip tablet. '
    uiTitik: {fileID: 575998657}
    mesinHighlight: []
    ghostHighlight:
    - {fileID: 0}
    - {fileID: 0}
  - teksLegenda: 'I. Pengencang Sealing Roll


      Mengatur jarak antara Sealing
      Roll A dan Sealing Roll B.'
    uiTitik: {fileID: 1312440394}
    mesinHighlight: []
    ghostHighlight:
    - {fileID: 0}
  - teksLegenda: 'J. Cover Sealing Roll


      Mencegah kontak fisik yang tidak
      disengaja dengan komponen mesin yang  bergerak.'
    uiTitik: {fileID: 1352273816}
    mesinHighlight: []
    ghostHighlight:
    - {fileID: 0}
  slideAreaBawah:
  - teksLegenda: 'K. Cutter Vertical


      Memotong Strip secara vertical unutk
      memisahkan antar Strip '
    uiTitik: {fileID: 1621631120}
    mesinHighlight:
    - {fileID: 2117581899}
    - {fileID: 1941980870}
    - {fileID: 1138513119}
    - {fileID: 264768933}
    ghostHighlight: []
  - teksLegenda: 'L. Cutter Horizontal


      Memotong Strip secara horizontal untuk
      mendapatkan jumlah Tablet yang sesuai dengan Setting '
    uiTitik: {fileID: 1204752080}
    mesinHighlight:
    - {fileID: 129703629}
    - {fileID: 8678155321557781750}
    - {fileID: 7869922822016874867}
    ghostHighlight: []
  slideInfoPartA:
  - teksLegenda: 'M. Cover Kanan


      Mencegah kontak fisik yang tidak disengaja
      dengan komponen mesin yang  bergerak.'
    uiTitik: {fileID: 1055986515}
    mesinHighlight: []
    ghostHighlight:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  tampilkanSemuaTitik: 0
