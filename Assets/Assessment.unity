    mesinHighlight:
    - {fileID: 1636836820}
    ghostHighlight: []
  - teksLegenda: 'C. Motor Power Off


      Menghentikan perputaran motor sehingga
      sealing roll berhenti berputar '
    uiTitik: {fileID: 620195816}
    mesinHighlight:
    - {fileID: 1915236250}
    ghostHighlight: []
  - teksLegenda: "D. Indicator Vibrator & Saklar Vibrator\n\nIndicator saklar vibrator
      menyala atau mati & Menyalakan atau mematikan Vibrator\n "
    uiTitik: {fileID: 984640455}
    mesinHighlight:
    - {fileID: 7953120689855119242}
    - {fileID: 6769665458712157194}
    ghostHighlight: []
  - teksLegenda: 'E. Indicator Cutter & Saklar Cutter


      Indicatpr saklar cutter
      menyala atau mati & Menyalakan atau mematikan sistem cutting '
    uiTitik: {fileID: 1532849239}
    mesinHighlight:
    - {fileID: 7836788912853660114}
    - {fileID: 6593533372474994888}
    ghostHighlight: []
  - teksLegenda: 'F. Indicator Cut Hole & Saklar Cut Hole


      Indicator Cut Hole
      menyala atau mati ; Menyalakan atau mematikan Cut Hole '
    uiTitik: {fileID: 1213208941}
    mesinHighlight:
