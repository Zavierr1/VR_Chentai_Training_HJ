    mesinHighlight:
    - {fileID: 1268632003}
    ghostHighlight: []
  - teksLegenda: 'B. Motor Power On


      Menyalakan motor sehingga sealing roll
      berputar '
    uiTitik: {fileID: 1943140114}
    mesinHighlight:
    - {fileID: 1636836820}
    ghostHighlight: []
  - teksLegenda: 'C. Motor Power Off


      Menghentikan perputaran motor sehingga
      sealing roll berhenti berputar '
    uiTitik: {fileID: 620195816}
    mesinHighlight:
    - {fileID: 1915236250}
    ghostHighlight: []
  - teksLegenda: "D. Indicator Vibrator & Saklar Vibrator\n\nIndicator saklar vibrator
      menyala atau mati & Menyalakan atau mematikan Vibrator\n "
    uiTitik: {fileID: 984640455}
