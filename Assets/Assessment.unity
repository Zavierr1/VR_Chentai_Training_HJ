    - {fileID: 9003598024029585288}
    ghostHighlight: []
  - teksLegenda: 'G. Indicator No & Saklar No


      Indicator saklar No menyala
      atau mati & Menyalakan atau mematikan proses No '
    uiTitik: {fileID: 511484781}
    mesinHighlight:
    - {fileID: 1087846249}
    - {fileID: 7656122710415352094}
    ghostHighlight: []
  - teksLegenda: 'H. Indicator Pre Heater & Saklar Pre Heater


      Indicator Pre
      Heater menyala atau mati & Menyalakan atau mematikan Pre Heater'
